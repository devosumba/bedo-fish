# ─── Environment variables ────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values before running locally.
# On Vercel, add each variable under Settings > Environment Variables.

# ─── Email (Nodemailer / Gmail SMTP) ─────────────────────────────────────────
# Use a Gmail account with an App Password (not your regular Gmail password).
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Resend (Order Emails) ────────────────────────────────────────────────────
# Get an API key at: https://resend.com/api-keys
RESEND_API_KEY=
ORDER_RECIPIENT_EMAIL=

# ─── Admin Dashboard (/admin) ─────────────────────────────────────────────────
# Comma-separated list of emails allowed to log in, and the shared password.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# ─── Google Maps (optional) ───────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── CallMeBot (optional WhatsApp HTTP fallback) ─────────────────────────────
CALLMEBOT_API_KEY=
